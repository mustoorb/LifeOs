# Copy to .env and fill in. Never commit .env.

# Database password for the bundled PostgreSQL (docker-compose only).
POSTGRES_PASSWORD=change-me

# 32+ random characters. Generate with: openssl rand -hex 32
LIFEOS_SECRET=

# Any SMTP provider. Examples:
#   Resend:   smtps://resend:API_KEY@smtp.resend.com:465
#   Postmark: smtp://SERVER_TOKEN:SERVER_TOKEN@smtp.postmarkapp.com:587
#   SES:      smtps://SMTP_USER:SMTP_PASS@email-smtp.eu-west-1.amazonaws.com:465
SMTP_URL=
# Must be an address your provider lets you send from.
MAIL_FROM="LifeOS <hello@your-domain.com>"
