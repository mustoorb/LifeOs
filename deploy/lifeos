#!/usr/bin/env bash
# Day-to-day commands for a self-hosted LifeOS: an Ubuntu server set up with deploy/setup.sh,
# or a Mac set up with deploy/mac.sh. Run `lifeos help`. Works with the bash 3.2 in macOS.
set -euo pipefail

if [[ $(uname) == Darwin ]]; then
  LIFEOS_DIR=${LIFEOS_DIR:-$HOME/LifeOS}
  BACKUP_DIR=${LIFEOS_BACKUP_DIR:-$HOME/LifeOS-backups}
  # cron starts with a bare PATH; OrbStack, Docker Desktop and Homebrew put docker in one of these.
  export PATH="$HOME/.orbstack/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
else
  if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
  LIFEOS_DIR=${LIFEOS_DIR:-/opt/lifeos}
  BACKUP_DIR=${LIFEOS_BACKUP_DIR:-/var/backups/lifeos}
fi
REPO=${LIFEOS_REPO:-mustoorb/LifeOs}
BRANCH=${LIFEOS_BRANCH:-main}
DUCKDNS_FILE=/etc/lifeos/duckdns
KEEP_BACKUP_DAYS=14

cd "$LIFEOS_DIR"

usage() {
  cat <<'EOF'
Usage: lifeos <command>

  status            Show the containers and check that LifeOS answers
  logs [service]    Follow the logs (server by default; also db, caddy)
  admin <args>      Run the admin CLI, e.g.
                      lifeos admin issue-codes --campaign founding --count 10 --expires-days 30
                      lifeos admin list-codes
                      lifeos admin set-role you@example.com admin
                      lifeos admin help
  update            Get the latest LifeOS from GitHub and restart
  start | stop      Start or stop LifeOS
  restart           Restart everything
  backup            Save a compressed database dump (also runs automatically)
  duckdns           Point your DuckDNS name at this server's IP (Linux setup only)
EOF
}

public_url() {
  local domain
  domain=$(sed -n 's/^LIFEOS_DOMAIN=//p' .env 2>/dev/null | tr -d "'\"")
  [[ -n $domain ]] && echo "https://$domain"
}

case "${1:-help}" in
  status)
    docker compose ps
    if curl -fsS --max-time 5 http://127.0.0.1:8787/v1/health >/dev/null; then echo "Server: healthy"; else echo "Server: not responding"; exit 1; fi
    if url=$(public_url); then
      if curl -fsS --max-time 10 "$url/v1/health" >/dev/null 2>&1; then echo "Public address: $url (reachable)"; else echo "Public address: $url (NOT reachable from here)"; fi
    fi
    ;;
  logs)
    docker compose logs -f --tail=200 "${2:-server}"
    ;;
  admin)
    shift
    docker compose exec -T server node apps/server/dist/cli.js "$@"
    ;;
  update)
    if [[ -d .git ]]; then
      git pull --ff-only
    else
      tmp=$(mktemp -d)
      curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" | tar -xz -C "$tmp"
      rsync -a --delete --exclude .env "$tmp"/*/ "$LIFEOS_DIR"/
      rm -rf "$tmp"
    fi
    docker compose up -d --build
    docker image prune -f >/dev/null
    echo "Updated."
    ;;
  start)
    docker compose up -d
    ;;
  stop)
    docker compose stop
    ;;
  restart)
    docker compose restart
    ;;
  backup)
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_DIR"
    # --if-due: the hourly job on a Mac, which may be asleep at any fixed time. One backup a day is enough.
    if [[ ${2:-} == --if-due ]] && [[ -n $(find "$BACKUP_DIR" -name 'lifeos-*.sql.gz' -mmin -1200 2>/dev/null) ]]; then exit 0; fi
    file="$BACKUP_DIR/lifeos-$(date -u +%Y%m%d-%H%M%S).sql.gz"
    umask 077
    docker compose exec -T db pg_dump -U lifeos --clean --if-exists lifeos | gzip >"$file.partial"
    mv "$file.partial" "$file"
    find "$BACKUP_DIR" -name 'lifeos-*.sql.gz' -mtime +"$KEEP_BACKUP_DAYS" -delete
    echo "Saved $file"
    ;;
  duckdns)
    [[ -f $DUCKDNS_FILE ]] || { echo "DuckDNS is not set up on this server."; exit 1; }
    # shellcheck source=/dev/null
    source "$DUCKDNS_FILE"
    result=$(curl -fsS --max-time 20 "https://www.duckdns.org/update?domains=${DUCKDNS_NAME}&token=${DUCKDNS_TOKEN}&ip=")
    [[ $result == OK ]] || { echo "DuckDNS answered: $result"; exit 1; }
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
